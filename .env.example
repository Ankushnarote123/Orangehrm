# Copy to .env to override defaults. All values are optional.
BASE_URL=https://opensource-demo.orangehrmlive.com
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Parallel workers: a number or a percentage of CPU cores, e.g. 4 or 50%. Default 2.
# WORKERS=2
# Times a failed test is retried. Default 2 (locally and on CI). 0 turns retries off.
# RETRIES=0
# Show the browser window (same as --headed). Default false = headless.
# HEADED=true
# Pause between browser actions in milliseconds, to follow a headed run. Default 0.
# SLOW_MO=500
# Set to false to skip building the Allure report after each run. Default true.
# ALLURE_GENERATE=false
# Slack or Microsoft Teams incoming-webhook URL. When set, a failure/flaky alert is posted after each run.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
